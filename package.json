{
  "name": "deps-diff-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that posts a visual dependency diff on every PR touching package.json",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "lint": "tsc --noEmit",
    "all": "npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Euphoria911/deps-diff-action.git"
  },
  "keywords": [
    "actions",
    "dependencies",
    "pull-request",
    "diff",
    "npm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.6.3"
  }
}
